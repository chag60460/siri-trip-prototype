# Hosted AI backend for the public deployment. Leave unset locally to keep using your Copilot login.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Any OpenAI-compatible provider. Takes priority over GEMINI_API_KEY when all three are set.
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Cerebras:   https://api.cerebras.ai/v1
# Mistral:    https://api.mistral.ai/v1
# xAI:        https://api.x.ai/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Space-separated origins allowed to embed the prototype in an iframe.
SIRI_EMBED_ORIGINS=https://chag60460.github.io
